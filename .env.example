# ═══════════════════════════════════════════════════
#  MACHINE À CACHE — Configuration
# ═══════════════════════════════════════════════════

# --- Capital & Mode ---
INITIAL_CAPITAL=10000          # Capital de départ en USDT
PAPER_TRADING=true             # true = simulation | false = ARGENT RÉEL ⚠️
TRADING_MODE=scalper

# --- Exchange Binance ---
# En paper trading, les clés sont optionnelles (données publiques)
# En live trading, créer des clés sur https://binance.com avec permission SPOT uniquement
BINANCE_API_KEY=
BINANCE_SECRET=

# --- APIs Analyse ---
# Alpha Vantage gratuit (25 req/jour): https://alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Claude Haiku pour analyse sentiment news
ANTHROPIC_API_KEY=

# --- Gestion du Risque ---
MAX_POSITION_PCT=0.02          # 2% du capital par trade
MAX_DAILY_LOSS_PCT=0.03        # Pause si perte > 3%/jour
MAX_DRAWDOWN_PCT=0.10          # Arrêt total si drawdown > 10%
MAX_CONCURRENT_POSITIONS=10    # Positions simultanées max
TAKE_PROFIT_PCT=0.003          # Take Profit à +0.3%
STOP_LOSS_PCT=0.0015           # Stop Loss à -0.15%
MAX_HOLD_SECONDS=90            # Durée max d'une position
MAX_SPREAD_PCT=0.001           # Spread max accepté (0.1%)
CONSECUTIVE_LOSS_COOLDOWN=300  # Cooldown 5min après 3 pertes consécutives
MAX_CONSECUTIVE_LOSSES=3

# --- Signaux ---
SIGNAL_THRESHOLD=0.6           # Score minimum pour trader (0-1)
SENTIMENT_WEIGHT=0.3           # Poids du sentiment dans le score final
TECHNICAL_WEIGHT=0.7           # Poids des indicateurs techniques
SCAN_INTERVAL=1.0              # Intervalle de scan en secondes

# --- Simulation (Paper Trading) ---
SLIPPAGE_PCT=0.0005            # Slippage simulé 0.05%
FEE_PCT=0.001                  # Frais Binance 0.1%

# --- News ---
NEWS_REFRESH_SECONDS=300       # Rafraîchissement news toutes les 5min

# --- Telegram (optionnel — rapports P&L) ---
BOT_TOKEN=                     # Token @BotFather
TELEGRAM_CHAT_ID=              # Ton chat_id (obtenir via @userinfobot)

# --- Base de données ---
DB_PATH=trades.db
