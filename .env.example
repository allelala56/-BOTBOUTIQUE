# ============================================================
# MACHINE À CACHE — Configuration
# Copie ce fichier en .env et remplis les valeurs
# ============================================================

# --- Capital & Mode ---
INITIAL_CAPITAL=10000          # Capital de départ en USDT
PAPER_TRADING=true             # true = simulation | false = ARGENT RÉEL (DANGER)

# --- Exchange ---
EXCHANGE_ID=binance
BINANCE_API_KEY=               # Clé API Binance (optionnel en paper trading)
BINANCE_SECRET=                # Secret API Binance

# --- Marchés à trader (séparés par des virgules) ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,MATIC/USDT,DOT/USDT

# --- APIs Analyse ---
ALPHA_VANTAGE_KEY=             # Gratuit sur alphavantage.co (25 req/jour)
ANTHROPIC_API_KEY=             # Claude Haiku pour analyse sentiment

# --- Telegram (optionnel) ---
BOT_TOKEN=                     # Token Telegram BotFather
TELEGRAM_CHAT_ID=              # Ton chat ID Telegram

# --- Gestion du risque ---
MAX_POSITION_PCT=0.02          # 2% du capital par trade max
MAX_CONCURRENT_POSITIONS=10    # Nombre max de positions simultanées
TAKE_PROFIT_PCT=0.003          # Take profit à +0.3%
STOP_LOSS_PCT=0.0015           # Stop loss à -0.15%
MAX_HOLD_SECONDS=90            # Durée max d'une position (secondes)
MAX_DAILY_LOSS_PCT=0.03        # Pause si perte journalière > 3%
MAX_DRAWDOWN_PCT=0.10          # Arrêt si drawdown > 10%
MAX_SPREAD_PCT=0.001           # Spread max accepté (0.1%)
SIGNAL_THRESHOLD=0.60          # Score min pour trader (0 à 1)
CONSECUTIVE_LOSS_COOLDOWN=3    # Cooldown après N pertes consécutives
COOLDOWN_SECONDS=300           # Durée du cooldown (secondes)

# --- Paramètres trading ---
SCAN_INTERVAL=1.0              # Fréquence de scan en secondes
SENTIMENT_INTERVAL=300         # Mise à jour sentiment (secondes)
SLIPPAGE_PCT=0.0005            # Slippage simulé (0.05%)
FEE_PCT=0.001                  # Frais Binance taker (0.1%)

# --- Base de données ---
DB_PATH=trades.db
