{% comment %}
  Snippet : price-display
  Usage : {% render 'price-display', variant: selected_variant, size: 'lg' %}
  size : 'sm' | 'md' | 'lg'
{% endcomment %}

{%- assign savings_pct = 0 -%}
{%- if variant.compare_at_price > variant.price -%}
  {%- assign savings_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
{%- endif -%}

{%- case size -%}
  {%- when 'sm' -%}
    {%- assign font_size = '1rem' -%}
    {%- assign compare_size = '0.8rem' -%}
  {%- when 'lg' -%}
    {%- assign font_size = '2.25rem' -%}
    {%- assign compare_size = '1.25rem' -%}
  {%- else -%}
    {%- assign font_size = '1.5rem' -%}
    {%- assign compare_size = '1rem' -%}
{%- endcase -%}

<div class="product-info__price-block" aria-label="Prix">
  <span
    class="product-info__price"
    style="font-size:{{ font_size }};"
    itemprop="price"
    content="{{ variant.price | divided_by: 100.0 }}"
  >
    {{ variant.price | money }}
  </span>

  {%- if variant.compare_at_price > variant.price -%}
    <span
      class="product-info__price-compare"
      style="font-size:{{ compare_size }};"
      aria-label="Prix original : {{ variant.compare_at_price | money }}"
    >
      {{ variant.compare_at_price | money }}
    </span>
    <span class="product-info__price-save">-{{ savings_pct }}%</span>
  {%- endif -%}
</div>
