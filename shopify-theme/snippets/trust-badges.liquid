{% comment %}
  Snippet : trust-badges
  Barre de réassurance — 3 colonnes
  Usage : {% render 'trust-badges' %}
{% endcomment %}

<div class="trust-bar" role="complementary" aria-label="Nos garanties">
  <div class="container">
    <ul class="trust-bar__inner" style="list-style:none;padding:0;">

      <li class="trust-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"/>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span>Livraison 5–9 jours en Suisse</span>
      </li>

      <li class="trust-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Garantie 30 jours satisfait ou remboursé</span>
      </li>

      <li class="trust-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
          <line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
        <span>Paiement sécurisé — Twint, CB, PayPal</span>
      </li>

      <li class="trust-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
          <polyline points="17 6 23 6 23 12"/>
        </svg>
        <span>Plus de 1 200 clients satisfaits</span>
      </li>

    </ul>
  </div>
</div>
